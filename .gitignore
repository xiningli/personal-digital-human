/node_modules
/.next/
/out/
.DS_Store
.env*
*.tsbuildinfo
next-env.d.ts
__pycache__/

# runtime data: rounds and votes are the owner's preference data
/data/

# synthesized speech for arena lines (the owner's cloned voice)
/public/audio/

# the avatar with the Mixamo clips baked in: deployed, never redistributed (see THIRD_PARTY.md)
/public/assets/*.glb

# generated motion and model outputs
/outputs/
/models/

# generated-motion workspace: venv, upstream checkouts, model weights and outputs
/motion/.venv/
/motion/pantomatrix/
/motion/emage_evaltools/
/motion/reference/
/motion/out/
/motion/*.log

# EMAGE fine-tune: derived dataset copies and training outputs (rebuild via finetune/prepare_dataset.py)
/motion/finetune/data/
/motion/finetune/outputs*/

# generated motion tracks (built by motion/build_tracks.py from the owner-voiced clips)
/public/motion/

# video-extraction workspace: venv, GVHMR checkout + checkpoints, downloaded videos, outputs
/motion/extract/.venv/
/motion/extract/GVHMR/
/motion/extract/videos/
/motion/extract/out/
/motion/extract/outputs/

# ref_means.json is the refinement baseline (committed); beat2/ is FGD reference data (ignored)
!/motion/reference/ref_means.json
